{
  "name": "@lwfjyjy/dsh-session-prompt-vault",
  "version": "0.2.3",
  "description": "输入框左侧新增快捷提示词按钮：弹窗管理提示词（增删改查），一键/回车/Tab 插入，支持提示词组合预设与 WebDAV 基础同步。",
  "type": "module",
  "license": "MIT",
  "author": "lwfjyjy",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./client.js": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.1-rc.5"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/lwfjyjy/dsh-session-prompt-vault.git"
  },
  "homepage": "https://github.com/lwfjyjy/dsh-session-prompt-vault",
  "bugs": {
    "url": "https://github.com/lwfjyjy/dsh-session-prompt-vault/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "prompts",
    "prompt-vault",
    "webdav"
  ]
}
